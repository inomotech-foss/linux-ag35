/dts-v1/;

#include "qcom-mdm9607.dtsi"
#include "qcom-pm8019.dtsi"
#include "qcom-mdm9607-regulators.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>

/ {
	model = "Qualcomm Technologies, Inc. MDM9607 MTP";
	compatible = "qcom,mdm9607-mtp", "qcom,mdm9607";
	qcom,msm-id = <290 0x10000>, <296 0x10000>, <297 0x10000>,
		      <298 0x10000>, <299 0x10000>;
	qcom,board-id = <8 0>;

	aliases {
		serial0 = &blsp1_uart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* Fixed 1.8 V rail for eMMC IO (SDC2 vqmmc).
	 * The physical supply is mdm9607_l13 set to 1.8 V by the
	 * bootloader / always-on constraint.  Model as fixed so the
	 * MMC core never attempts 3.3 V → 1.8 V voltage switching.
	 * vin-supply keeps l13 enabled (prevents regulator framework
	 * from disabling the unused PMIC LDO). */
	sdc2_vqmmc_fixed: sdc2-vqmmc-fixed {
		compatible = "regulator-fixed";
		regulator-name = "sdc2_vqmmc_1p8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&mdm9607_l13>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* Fixed ~2.95 V rail for eMMC card power (SDC2 vmmc).
	 * On the AG35 EVB the eMMC VCC is always-on from a board-level
	 * LDO (downstream comments out vdd-supply entirely and uses
	 * qcom,vdd-voltage-level = <2850000 2850000>).
	 * Model as a fixed regulator so mmc_regulator_get_ocrmask()
	 * returns a valid OCR (MMC_VDD_29_30).  Without this, the SDHCI
	 * caps register may not report VDD support after controller reset,
	 * leaving ocr_avail=0 and preventing any power-up/CMD1 sequence. */
	sdc2_vmmc_fixed: sdc2-vmmc-fixed {
		compatible = "regulator-fixed";
		regulator-name = "sdc2_vmmc_2p95";
		regulator-min-microvolt = <2950000>;
		regulator-max-microvolt = <2950000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

/* BLSP1 UART2 (gpio4/5): debug console */
&blsp1_uart2 {
	status = "okay";
};

/*
 * ===== DIAGNOSTIC: everything below disabled to isolate reset cause =====
 * If boot progresses past ~2.8s, one of these devices causes the reset.
 * Re-enable them one by one to find the culprit.
 */

/* BLSP1 UART3 (gpio0/1/2/3): modem AT command port */
/* &blsp1_uart3 { status = "okay"; }; */

/* Modem remoteproc - loads and manages modem firmware */
&remoteproc_mss {
	status = "okay";
};

/* BAM-DMUX: modem data path (modem is pre-loaded by SBL1) */
&bam_dmux_dma { status = "okay"; };
&bam_dmux { status = "okay"; };

/* &blsp1_i2c2 { status = "okay"; }; */
/* &blsp1_i2c4 { status = "okay"; }; */
/* &blsp1_spi6 { status = "okay"; }; */

/* eMMC on SDCC1 */
/* &sdhc_1 { status = "okay"; ... }; */

/* eMMC on SDCC2 (LTE OPEN EVB: Micron MTFC4GACAJCN-4M, S0701 -> right)
 *
 * Downstream (mdm9607-mtp.dtsi) wires SDC2 as follows:
 *   vdd-io  = mdm9607_l13 @ 1.8 V, always-on
 *   qcom,nonhotplug (= non-removable)
 *   bus-width 4, no vmmc (eMMC chip power is board-level LDO)
 *   bus scaling via qcom,msm-bus (proprietary, not mainline interconnect)
 *
 * The mainline dtsi adds interconnects/OPP/power-domains, but the
 * bimc & pcnoc interconnect providers are disabled (driver bugs), so
 * sdhci-msm gets stuck in deferred probe on dev_pm_opp_of_find_icc_paths.
 * Delete those properties to let the controller probe without bus scaling.
 *
 * The IO rail (vqmmc) is hard-wired at 1.8 V (downstream: vdd-io-always-on
 * + voltage-level 1800000/1800000).  mdm9607_l13 has a range up to 2.85 V,
 * so the MMC core tries 2.85 V first, which the 1.8 V-only eMMC ignores.
 * Use a fixed-voltage regulator to prevent voltage switching attempts.
 */
&sdhc_2 {
	vmmc-supply = <&sdc2_vmmc_fixed>;
	vqmmc-supply = <&sdc2_vqmmc_fixed>;
	bus-width = <4>;
	non-removable;
	no-sd;
	no-sdio;
	mmc-hs200-1_8v;
	mmc-ddr-1_8v;
	post-power-on-delay-ms = <200>;
	status = "okay";

	/delete-property/ interconnects;
	/delete-property/ operating-points-v2;
	/delete-property/ power-domains;
};

/* USB HS in peripheral mode (ChipIdea UDC + 28nm SNPS Femto PHY)
 *
 * Regulator supplies follow downstream AG35EVD wiring:
 *   hsusb_vdd_dig -> mdm9607_l9 (1.2 V digital core)
 *   HSUSB_1p8     -> mdm9607_l2 (1.8 V analog)
 *   HSUSB_3p3     -> mdm9607_l4 (3.075 V analog)
 */
&usb_hs_phy {
	vdd-supply = <&mdm9607_l9>;
	vdda1p8-supply = <&mdm9607_l2>;
	vdda3p3-supply = <&mdm9607_l4>;
	status = "okay";
};

/*
 * USB HS ChipIdea controller (peripheral mode).
 *
 * The earlier "boot freeze when &usb was enabled" was a red herring: the
 * real cause was an unrelated rpmsg_tty NULL-deref race (fixed in
 * drivers/tty/rpmsg_tty.c).  With that fixed, enable the controller.
 */
&usb {
	status = "okay";
};

/* QPIC NAND */
&qpic_bam { status = "okay"; };
&qpic_nand { status = "okay"; };

